import json
import os

FILE_NAME = "library.txt"


# Load books from file
def load_books():
    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                return json.load(file)
        except (json.JSONDecodeError, OSError):
            return []
    return []


# Save books in file
def save_books(books):
    with open(FILE_NAME, "w") as file:
        json.dump(books, file, indent=4)


# Generate book ID
def generate_book_id(books):
    highest_number = 100

    for book in books:
        number = int(book["id"][1:])
        if number > highest_number:
            highest_number = number

    return "B" + str(highest_number + 1)


# Add a new book
def add_book(books):
    print("\n--- Add Book ---")

    title = input("Enter book title: ").strip()
    author = input("Enter author name: ").strip()

    if title == "" or author == "":
        print("Title and author cannot be empty.")
        return

    book_id = generate_book_id(books)

    book = {
        "id": book_id,
        "title": title,
        "author": author,
        "status": "Available",
        "member": ""
    }

    books.append(book)
    save_books(books)

    print("Book added. ID:", book_id, "|", title, "|", author, "| Available")


# Issue a book
def issue_book(books):
    print("\n--- Issue Book ---")

    book_id = input("Enter book ID: ").strip().upper()
    member = input("Enter member name: ").strip()

    if member == "":
        print("Member name cannot be empty.")
        return

    for book in books:
        if book["id"] == book_id:

            if book["status"] == "Issued":
                print("Book is already issued.")
                return

            book["status"] = "Issued"
            book["member"] = member

            save_books(books)

            available_count = 0

            for item in books:
                if item["status"] == "Available":
                    available_count += 1

            print("Book", book_id, "issued to", member + ". Status: Issued")
            print("Available books:", available_count)
            return

    print("Book ID", book_id, "not found.")


# Return a book
def return_book(books):
    print("\n--- Return Book ---")

    book_id = input("Enter book ID: ").strip().upper()

    for book in books:
        if book["id"] == book_id:

            if book["status"] == "Available":
                print("This book is already available.")
                return

            book["status"] = "Available"
            book["member"] = ""

            save_books(books)

            print("Book", book_id, "returned. Status: Available")
            return

    print("Book ID", book_id, "not found.")


# Search a book
def search_book(books):
    print("\n--- Search Book ---")

    print("1. Search by title")
    print("2. Search by author")

    choice = input("Choose search type: ").strip()

    if choice == "1":
        search_text = input("Enter book title: ").strip().lower()
        field = "title"

    elif choice == "2":
        search_text = input("Enter author name: ").strip().lower()
        field = "author"

    else:
        print("Invalid search option.")
        return

    found = False

    for book in books:
        if search_text in book[field].lower():

            print(
                book["id"], "|",
                book["title"], "|",
                book["author"], "|",
                book["status"]
            )

            found = True

    if not found:
        print("No matching book found.")


# Display all books
def display_books(books):
    print("\n--- All Books ---")

    if len(books) == 0:
        print("No books in the library.")
        return

    for book in books:
        print(
            book["id"], "|",
            book["title"], "|",
            book["author"], "|",
            book["status"]
        )


# Main function
def main():
    books = load_books()

    while True:

        print("\n========== LIBRARY MANAGEMENT SYSTEM ==========")
        print("1. Add Book")
        print("2. Issue Book")
        print("3. Return Book")
        print("4. Search Book")
        print("5. Display All Books")
        print("6. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            add_book(books)

        elif choice == "2":
            issue_book(books)

        elif choice == "3":
            return_book(books)

        elif choice == "4":
            search_book(books)

        elif choice == "5":
            display_books(books)

        elif choice == "6":
            save_books(books)
            print("Data saved. Thank you!")
            break

        else:
            print("Invalid choice. Please select from 1 to 6.")


if __name__ == "__main__":
    main()
